# Copy this file to cluster/cluster.env and edit it for your worker.
# cluster/cluster.env is ignored by Git.

# SSH destination. A Tailscale MagicDNS name is recommended.
RAY_WORKER_SSH=user@ray-worker

# Repository directory relative to the remote user's home directory.
# An absolute path also works. Avoid ~ because commands quote this value.
RAY_REMOTE_DIR=ray_primer

# Optional. By default the command discovers the main machine's Tailscale IPv4.
# RAY_HEAD_IP=100.64.0.10

# Optional Ray GCS port.
RAY_HEAD_PORT=6379

# Optional SSH settings.
# RAY_SSH_PORT=22
# RAY_SSH_IDENTITY=/Users/me/.ssh/id_ed25519

# Optional resource overrides advertised to Ray.
# RAY_HEAD_CPUS=4
# RAY_WORKER_CPUS=8
